# Multi-stage build: compile libhartonomous + pg extension, install into PostGIS image.
# Usage: docker compose build postgres
#
# Intel oneAPI is sourced from the official intel/oneapi-* images so a rebuild does
# NOT re-download multi-GB packages from apt.repos.intel.com. The oneAPI layer is
# pulled exactly once per host (cached by Docker), reused across every rebuild
# until you `docker pull intel/oneapi-basekit:latest` again.
#
# Library coverage (per CPU-only mandate — every Intel library is in, not just MKL):
#   MKL, IPP, TBB, oneDNN, oneDAL, oneDPL, oneCCL, OpenMP, DPC++ compiler runtime.

# ── Stage 0: pre-built Intel oneAPI runtime image (cached by Docker) ──
# Used as a COPY source in the final stage so no apt-get install of Intel
# packages happens at runtime-image build time.
FROM intel/oneapi-runtime:latest AS oneapi-runtime

# ── Stage 1: Builder — Intel basekit (has full devel toolchain pre-installed) ──
# basekit ships with: MKL-devel, IPP-devel, TBB-devel, oneDNN-devel, oneDAL-devel,
# oneDPL, oneCCL, DPC++ compiler, OpenMP. No apt-get install of Intel packages here.
FROM intel/oneapi-basekit:latest AS builder

# Add the PostgreSQL apt repo so we can install postgresql-server-dev-17 against
# the same major version PostGIS 17 ships. Pinning the keyring + repo gives us a
# reproducible builder layer that gets cached as long as the keys don't rotate.
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget ca-certificates gnupg lsb-release \
        build-essential cmake git pkg-config \
    && wget -qO- https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor > /usr/share/keyrings/pgdg.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/pgdg.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        postgresql-server-dev-17 \
    && rm -rf /var/lib/apt/lists/*

# Source oneAPI environment so cmake's find_package picks up MKL/IPP/TBB/DNN/DAL.
ENV ONEAPI_ROOT=/opt/intel/oneapi
ENV MKLROOT=/opt/intel/oneapi/mkl/latest
ENV IPPROOT=/opt/intel/oneapi/ipp/latest
ENV TBBROOT=/opt/intel/oneapi/tbb/latest
ENV DNNLROOT=/opt/intel/oneapi/dnnl/latest
ENV DALROOT=/opt/intel/oneapi/dal/latest
ENV DPLROOT=/opt/intel/oneapi/dpl/latest
ENV CCL_ROOT=/opt/intel/oneapi/ccl/latest
ENV CMPLR_ROOT=/opt/intel/oneapi/compiler/latest
ENV LD_LIBRARY_PATH=${MKLROOT}/lib:${IPPROOT}/lib:${TBBROOT}/lib:${DNNLROOT}/lib:${DALROOT}/lib:${CCL_ROOT}/lib:${CMPLR_ROOT}/lib
ENV CMAKE_PREFIX_PATH=${MKLROOT}/lib/cmake/mkl:${IPPROOT}/lib/cmake/ipp:${TBBROOT}/lib/cmake/tbb:${DNNLROOT}/lib/cmake/dnnl:${DALROOT}/lib/cmake/oneDAL

COPY ext/libhartonomous /build/libhartonomous
WORKDIR /build/libhartonomous
RUN cmake -S . -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DHARTONOMOUS_BUILD_TESTS=OFF \
        -DHARTONOMOUS_BUILD_SHARED=ON \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
    && cmake --build build --config Release -j \
    && cp build/bin/libhartonomous.so /usr/local/lib/

COPY ext/hartonomous_pg /build/hartonomous_pg
WORKDIR /build/hartonomous_pg
RUN make PG_CONFIG=/usr/bin/pg_config install

# ── Stage 2: Runtime — PostGIS + Intel runtime libs copied in (no apt install) ──
FROM postgis/postgis:17-3.5

# Pull the entire Intel runtime tree from the cached oneapi-runtime stage. This
# is the ONLY place runtime libs come from — no apt repo, no network call.
COPY --from=oneapi-runtime /opt/intel /opt/intel

COPY --from=builder /usr/local/lib/libhartonomous.so                     /usr/local/lib/
COPY --from=builder /usr/lib/postgresql/17/lib/hartonomous.so            /usr/lib/postgresql/17/lib/
COPY --from=builder /usr/share/postgresql/17/extension/hartonomous.control       /usr/share/postgresql/17/extension/
COPY --from=builder /usr/share/postgresql/17/extension/hartonomous--1.0.sql      /usr/share/postgresql/17/extension/

# intel/oneapi-runtime image flattens every component's libs into a single
# /opt/intel/oneapi/redist/lib tree (MKL, IPP, TBB, DNN, DAL, DPL, CCL, OpenMP,
# DPC++ compiler runtime are all present there). Pointing ldconfig at that one
# directory exposes the entire runtime to libhartonomous.so + hartonomous.so.
RUN echo "/opt/intel/oneapi/redist/lib" > /etc/ld.so.conf.d/oneapi.conf \
    && ldconfig

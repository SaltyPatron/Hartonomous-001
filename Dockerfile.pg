# syntax=docker/dockerfile:1.7
#
# Hartonomous PostgreSQL extension image — registry-cached layers only.
#
# Three pinned upstream images, each cached as Docker image layers in the
# Docker Hub registry. A fresh machine pulls them once via `docker pull`.
# `docker rmi` followed by `docker compose up` re-pulls the same cached
# layers — NO apt-get against repos.intel.com, NO multi-GB Intel install
# happens inside any RUN layer of this Dockerfile.
#
#   Builder  : intel/oneapi-hpckit:2025.3.1-0-devel-ubuntu22.04
#              — full oneAPI dev (MKL, IPP, TBB, oneDNN, oneDAL, DPC++, OpenMP)
#                pre-baked into image layers by Intel (verified on Docker Hub).
#   Runtime  : postgis/postgis:17-3.5
#              — official Postgres 17 + PostGIS 3.5, Debian bookworm.
#   Intel rt : intel/oneapi-runtime:2025.3.1-0-devel-ubuntu22.04
#              — runtime-only oneAPI shared libraries, also pre-baked by Intel.
#
# Library coverage stays identical to before (every Intel CPU library, not
# just MKL): MKL + IPP + TBB + oneDNN + oneDAL + oneDPL + OpenMP + DPC++ rt.
#
# Determinism note: the runtime stage uses Debian bookworm (PostGIS 17-3.5)
# while the builder uses Ubuntu 22.04 (oneAPI hpckit). Both are glibc>=2.34,
# so libhartonomous.so links against symbols that resolve cleanly under either.
# The Intel runtime libs are copied straight from the registry layer, so they
# carry their own glibc-compatible loader paths.

# ---------------------------------------------------------------------------
# Stage 1: Builder — Intel oneAPI HPC kit (registry-cached, no apt-get-Intel)
# ---------------------------------------------------------------------------
FROM intel/oneapi-hpckit:2025.3.1-0-devel-ubuntu22.04 AS builder

# Add the official PostgreSQL apt repo for Ubuntu jammy so we can pull
# postgresql-server-dev-17 against the same major version PostGIS 17 ships.
# This is the ONLY apt-get install in any layer of this Dockerfile, and it
# pulls only Postgres dev headers + a tiny build-essential — not Intel.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        wget ca-certificates gnupg lsb-release \
        build-essential cmake git pkg-config \
 && wget -qO- https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor > /usr/share/keyrings/pgdg.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/pgdg.gpg] http://apt.postgresql.org/pub/repos/apt jammy-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-server-dev-17

# oneAPI environment is already baked into the image; just point at it.
ENV ONEAPI_ROOT=/opt/intel/oneapi
ENV MKLROOT=/opt/intel/oneapi/mkl/latest
ENV IPPROOT=/opt/intel/oneapi/ipp/latest
ENV TBBROOT=/opt/intel/oneapi/tbb/latest
ENV DNNLROOT=/opt/intel/oneapi/dnnl/latest
ENV DALROOT=/opt/intel/oneapi/dal/latest
ENV DPLROOT=/opt/intel/oneapi/dpl/latest
ENV CCL_ROOT=/opt/intel/oneapi/ccl/latest
ENV CMPLR_ROOT=/opt/intel/oneapi/compiler/latest
ENV LD_LIBRARY_PATH=${MKLROOT}/lib:${IPPROOT}/lib:${TBBROOT}/lib:${DNNLROOT}/lib:${DALROOT}/lib:${CCL_ROOT}/lib:${CMPLR_ROOT}/lib
ENV CMAKE_PREFIX_PATH=${MKLROOT}/lib/cmake/mkl:${IPPROOT}/lib/cmake/ipp:${TBBROOT}/lib/cmake/tbb:${DNNLROOT}/lib/cmake/dnnl:${DALROOT}/lib/cmake/oneDAL

# Build libhartonomous (BLAKE3 + S3 + 4D geometry + Lanczos/SVD/Procrustes/etc).
COPY ext/libhartonomous /build/libhartonomous
WORKDIR /build/libhartonomous
RUN cmake -S . -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DHARTONOMOUS_BUILD_TESTS=OFF \
        -DHARTONOMOUS_BUILD_SHARED=ON \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
 && cmake --build build --config Release -j \
 && cp build/bin/libhartonomous.so /usr/local/lib/

# Build the hartonomous PG extension (.so + .control + --1.0.sql).
COPY ext/hartonomous_pg /build/hartonomous_pg
WORKDIR /build/hartonomous_pg
RUN make PG_CONFIG=/usr/bin/pg_config install

# ---------------------------------------------------------------------------
# Stage 2: Intel oneAPI runtime — declared as a named stage so BuildKit
# resolves it from the local `docker images` store after one `docker pull
# intel/oneapi-runtime:2025.3.1-0-devel-ubuntu22.04`. NO re-pull on rebuild,
# NO BuildKit-internal cache games — the image lives in the regular Docker
# image store and is visible in `docker images`.
# ---------------------------------------------------------------------------
FROM intel/oneapi-runtime:2025.3.1-0-devel-ubuntu22.04 AS oneapi_runtime

# ---------------------------------------------------------------------------
# Stage 3: Runtime — PostGIS 17 + Intel oneAPI runtime libs (from local stage)
# ---------------------------------------------------------------------------
FROM postgis/postgis:17-3.5

# Pull every Intel runtime shared library from the locally-resolved
# oneapi_runtime stage. The runtime image flattens all components
# (mkl, ipp, tbb, dnnl, onedal, openmp, ccl, opencl, ifcore, ...) into
# /opt/intel/oneapi/redist/lib/  with the compiler/openmp runtime under
# /opt/intel/oneapi/redist/opt/compiler/lib/. No network, no apt.
COPY --from=oneapi_runtime /opt/intel/oneapi/redist/lib          /opt/intel/oneapi/redist/lib
COPY --from=oneapi_runtime /opt/intel/oneapi/redist/opt/compiler /opt/intel/oneapi/redist/opt/compiler

# Pull the built artifacts from the builder stage.
COPY --from=builder /usr/local/lib/libhartonomous.so                            /usr/local/lib/
COPY --from=builder /usr/lib/postgresql/17/lib/hartonomous.so                   /usr/lib/postgresql/17/lib/
COPY --from=builder /usr/share/postgresql/17/extension/hartonomous.control      /usr/share/postgresql/17/extension/
COPY --from=builder /usr/share/postgresql/17/extension/hartonomous--1.0.sql     /usr/share/postgresql/17/extension/

# Defensive: remove any libstdc++.so.6 that may have been left in /usr/local/lib by
# a previously-cached layer. The runtime base (postgis/postgis:17-3.5 = Debian 11,
# glibc 2.31) ships its own /usr/lib/x86_64-linux-gnu/libstdc++.so.6.0.28 which is
# what every binary including libhartonomous.so must resolve to. A stale newer
# libstdc++.so.6 in /usr/local/lib (e.g. left over from a Ubuntu-22.04-built copy)
# requires GLIBC_2.32+ symbols that bullseye does not provide, causing initdb and
# every postgres binary to fail at dynamic-linker time.
RUN rm -f /usr/local/lib/libstdc++.so.6 /usr/local/lib/libstdc++.so.6.* /usr/local/lib/libstdc++.so

# Register the Intel runtime library directories with ldconfig so PG's dynamic
# loader finds every transitive dependency of libhartonomous.so at startup.
# /usr/local/lib covers libhartonomous.so.0 and the builder-supplied libstdc++.so.6.
RUN echo "/usr/local/lib"                                >  /etc/ld.so.conf.d/oneapi.conf \
 && echo "/opt/intel/oneapi/redist/lib"                  >> /etc/ld.so.conf.d/oneapi.conf \
 && echo "/opt/intel/oneapi/redist/lib/intel64"          >> /etc/ld.so.conf.d/oneapi.conf \
 && echo "/opt/intel/oneapi/redist/opt/compiler/lib"     >> /etc/ld.so.conf.d/oneapi.conf \
 && ldconfig

# Preload the hartonomous extension at server startup so _PG_init runs in the
# postmaster context. Required for PGC_POSTMASTER GUCs (strict_determinism)
# and for pinning MKL CBWR=AUTO,STRICT before any compute runs (Law #6).
# The preload-config script sql/init/00_preload.sh is bind-mounted into
# /docker-entrypoint-initdb.d/ by docker-compose.

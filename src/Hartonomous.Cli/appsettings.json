{
  "Hartonomous": {
    "DataRoot": "/vault/Data",
    "ConnectionString": "Host=/var/run/postgresql;Port=5432;Database=hartonomous;Include Error Detail=true;Minimum Pool Size=8;Maximum Pool Size=32;Multiplexing=true;Command Timeout=600;Application Name=hartonomous-cli;",
    "Decomposers": {
      "Ucd": {
        "SourcePath": "Unicode/Public/UCD/latest"
      },
      "Iso639": {
        "SourcePath": "ISO639"
      },
      "WordNet": {
        "SourcePath": "Wordnet/WordNet-3.0/dict"
      },
      "Omw": {
        "SourcePath": "omw",
        "LanguageFilter": [ "en", "eng" ]
      },
      "Ud": {
        "SourcePath": "UD-Treebanks/ud-treebanks-v2.17",
        "LanguageFilter": [ "en", "eng" ]
      },
      "Safetensors": {
        "HubPath": "hub",
        "ModelFilter": [ "sentence-transformers/all-MiniLM-L6-v2" ]
      },
      "Wiktionary": {
        "SourcePath": "Wiktionary",
        "LanguageFilter": [ "en", "eng" ]
      },
      "Tatoeba": {
        "SourcePath": "Tatoeba",
        "LanguageFilter": [ "en", "eng" ]
      },
      "Text": {
        "SourcePath": "test_data/text"
      }
    }
  }
}

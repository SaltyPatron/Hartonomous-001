# syntax=docker/dockerfile:1.7
# Multi-stage build: compile libhartonomous + pg extension, install into PostGIS image.
# Usage: docker compose build postgres
#
# Intel oneAPI is sourced from the official intel/oneapi-* images so a rebuild does
# NOT re-download multi-GB packages from apt.repos.intel.com. The oneAPI layer is
# pulled exactly once per host (cached by Docker), reused across every rebuild
# until you `docker pull intel/oneapi-basekit:latest` again.
#
# Library coverage (per CPU-only mandate — every Intel library is in, not just MKL):
#   MKL, IPP, TBB, oneDNN, oneDAL, oneDPL, oneCCL, OpenMP, DPC++ compiler runtime.

# ── Stage 1: Builder — Intel oneAPI on Debian 11 bullseye ──
# postgis/postgis only ships a Debian 11 bullseye tag for 17-3.5 (no bookworm
# variant exists on Docker Hub as of the publishing window we depend on), so
# the builder must also live on bullseye — glibc 2.31 — to keep the .so loadable
# in the runtime postmaster process. Intel publishes the oneAPI apt repo as
# distro-agnostic (`all main`), so we layer it onto a stock postgres:17-bullseye.
FROM postgres:17-bullseye AS builder

# Add the PostgreSQL apt repo so we can install postgresql-server-dev-17 against
# the same major version PostGIS 17 ships. Add the Intel oneAPI apt repo so we
# can pull MKL/IPP/TBB/DNN/DAL/compiler -devel packages onto bookworm — this
# replaces the prior intel/oneapi-basekit base image, which lived on Ubuntu and
# produced glibc-mismatched binaries against the bookworm runtime stage.
#
# BuildKit cache mounts on /var/cache/apt and /var/lib/apt/lists keep the
# downloaded .deb files on the host across rebuilds AND across `docker rmi`.
# First build downloads ~5 GB once; every subsequent build reuses the cached
# debs even if the entire image was deleted. Note: do NOT run apt-get clean
# or rm -rf /var/lib/apt/lists — that defeats the cache mount.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update && apt-get install -y --no-install-recommends \
        wget ca-certificates gnupg lsb-release \
        build-essential cmake git pkg-config \
    && wget -qO- https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor > /usr/share/keyrings/pgdg.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/pgdg.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && wget -qO- https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB \
        | gpg --dearmor > /usr/share/keyrings/oneapi-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/oneapi-archive-keyring.gpg] https://apt.repos.intel.com/oneapi all main" \
        > /etc/apt/sources.list.d/oneAPI.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        postgresql-server-dev-17 \
        intel-oneapi-mkl-devel \
        intel-oneapi-ipp-devel \
        intel-oneapi-tbb-devel \
        intel-oneapi-dnnl-devel \
        intel-oneapi-dal-devel \
        intel-oneapi-dpcpp-cpp-2025.0 \
        intel-oneapi-openmp

# Source oneAPI environment so cmake's find_package picks up MKL/IPP/TBB/DNN/DAL.
ENV ONEAPI_ROOT=/opt/intel/oneapi
ENV MKLROOT=/opt/intel/oneapi/mkl/latest
ENV IPPROOT=/opt/intel/oneapi/ipp/latest
ENV TBBROOT=/opt/intel/oneapi/tbb/latest
ENV DNNLROOT=/opt/intel/oneapi/dnnl/latest
ENV DALROOT=/opt/intel/oneapi/dal/latest
ENV DPLROOT=/opt/intel/oneapi/dpl/latest
ENV CCL_ROOT=/opt/intel/oneapi/ccl/latest
ENV CMPLR_ROOT=/opt/intel/oneapi/compiler/latest
ENV LD_LIBRARY_PATH=${MKLROOT}/lib:${IPPROOT}/lib:${TBBROOT}/lib:${DNNLROOT}/lib:${DALROOT}/lib:${CCL_ROOT}/lib:${CMPLR_ROOT}/lib
ENV CMAKE_PREFIX_PATH=${MKLROOT}/lib/cmake/mkl:${IPPROOT}/lib/cmake/ipp:${TBBROOT}/lib/cmake/tbb:${DNNLROOT}/lib/cmake/dnnl:${DALROOT}/lib/cmake/oneDAL

COPY ext/libhartonomous /build/libhartonomous
WORKDIR /build/libhartonomous
RUN cmake -S . -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DHARTONOMOUS_BUILD_TESTS=OFF \
        -DHARTONOMOUS_BUILD_SHARED=ON \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
    && cmake --build build --config Release -j \
    && cp build/bin/libhartonomous.so /usr/local/lib/

COPY ext/hartonomous_pg /build/hartonomous_pg
WORKDIR /build/hartonomous_pg
RUN make PG_CONFIG=/usr/bin/pg_config install

# ── Stage 2: Runtime — PostGIS bullseye + Intel runtime libs via apt ──
# Bullseye matches the builder so the .so loads cleanly. Intel runtime libs
# come from the same oneAPI apt repo so every shared object on the loader
# path was linked against the same glibc 2.31.
FROM postgis/postgis:17-3.5

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update && apt-get install -y --no-install-recommends \
        wget ca-certificates gnupg lsb-release \
    && wget -qO- https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB \
        | gpg --dearmor > /usr/share/keyrings/oneapi-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/oneapi-archive-keyring.gpg] https://apt.repos.intel.com/oneapi all main" \
        > /etc/apt/sources.list.d/oneAPI.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        intel-oneapi-runtime-mkl \
        intel-oneapi-runtime-ipp \
        intel-oneapi-runtime-tbb \
        intel-oneapi-runtime-dnnl \
        intel-oneapi-runtime-dal \
        intel-oneapi-runtime-compilers \
        intel-oneapi-runtime-openmp

COPY --from=builder /usr/local/lib/libhartonomous.so                     /usr/local/lib/
COPY --from=builder /usr/lib/postgresql/17/lib/hartonomous.so            /usr/lib/postgresql/17/lib/
COPY --from=builder /usr/share/postgresql/17/extension/hartonomous.control       /usr/share/postgresql/17/extension/
COPY --from=builder /usr/share/postgresql/17/extension/hartonomous--1.0.sql      /usr/share/postgresql/17/extension/

# Intel runtime apt packages install into /opt/intel/oneapi/<component>/<ver>/lib.
# Point ldconfig at the canonical "latest" symlinks so libhartonomous.so finds
# every Intel runtime dependency at load time.
RUN echo "/opt/intel/oneapi/mkl/latest/lib"      >  /etc/ld.so.conf.d/oneapi.conf \
    && echo "/opt/intel/oneapi/ipp/latest/lib"      >> /etc/ld.so.conf.d/oneapi.conf \
    && echo "/opt/intel/oneapi/tbb/latest/lib"      >> /etc/ld.so.conf.d/oneapi.conf \
    && echo "/opt/intel/oneapi/dnnl/latest/lib"     >> /etc/ld.so.conf.d/oneapi.conf \
    && echo "/opt/intel/oneapi/dal/latest/lib"      >> /etc/ld.so.conf.d/oneapi.conf \
    && echo "/opt/intel/oneapi/compiler/latest/lib" >> /etc/ld.so.conf.d/oneapi.conf \
    && ldconfig

# Preload the hartonomous extension at server startup so _PG_init runs in the
# postmaster context. Required for two reasons:
#   1. PGC_POSTMASTER GUCs (hartonomous.strict_determinism) can ONLY be defined
#      during postmaster startup; loading via CREATE EXTENSION fails otherwise.
#   2. Law #6 (byte determinism) requires MKL CBWR=AUTO,STRICT pinned BEFORE any
#      compute runs in any backend, not lazily at first SQL call.
#
# The preload-config script lives in sql/init/00_preload.sh and is bind-mounted
# into /docker-entrypoint-initdb.d/ by docker-compose. It runs during initdb
# (against a temp postmaster), appends shared_preload_libraries='hartonomous'
# to postgresql.conf, then the temp postmaster stops and the real postmaster
# starts with hartonomous already preloaded.

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/session-context.ps1\"",
            "timeout": 15,
            "statusMessage": "Loading Hartonomous agent context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/block-destructive-command.ps1\"",
            "timeout": 10,
            "statusMessage": "Checking destructive shell command policy"
          }
        ]
      }
    ]
  }
}
